<form class="impulso sheet actor-sheet" autocomplete="off">
  <div class="actor-header">
    <div class="header-left">
      <input id="actor-name" class="name-input" type="text" name="name" value="{{actor.name}}" />
      <span class="label ego-label">Ego</span>
      <input
        id="actor-ego-temp"
        type="text"
        inputmode="numeric"
        pattern="\\d{0,2}"
        maxlength="2"
        name="system.ego.temp"
        value="{{system.ego.temp}}"
        placeholder="Temp"
      />
      <input
        id="actor-ego-total"
        type="text"
        inputmode="numeric"
        pattern="\\d{0,2}"
        maxlength="2"
        name="system.ego.total"
        value="{{system.ego.total}}"
        placeholder="Total"
      />
      {{#if showCorruption}}
      <span class="label corr-label">Corrupción</span>
      <input
        id="actor-corruption"
        type="text"
        inputmode="numeric"
        pattern="\\d{0,2}"
        maxlength="2"
        name="system.corrupcion"
        value="{{system.corrupcion}}"
      />
      {{/if}}

      <textarea
        id="actor-description"
        name="system.descripcion"
        rows="2"
        placeholder="Descripción"
      >{{system.descripcion}}</textarea>

      <div class="state-row">
        <span class="label">Estado</span>
        <div class="state-options">
          {{#each stateOptions}}
            <label class="state-chip">
              <input type="checkbox" name="system.estadoFlags.{{id}}" value="{{id}}" {{checked checked}} />
              <span>{{label}}</span>
            </label>
          {{/each}}
        </div>
      </div>
    </div>

    <div class="header-photo">
      <img class="profile-img" src="{{actor.img}}" data-edit="img" alt="{{actor.name}}" />
    </div>
  </div>

  <div class="actor-actions">
    <div class="roll-controls">
      <div class="dice-icon" data-action="rollDice">
        <i class="fa-solid fa-dice-d12"></i>
      </div>
      <select class="difficulty-select">
        <option value="6">6</option>
        <option value="9">9</option>
        <option value="12">12</option>
        <option value="15" selected>15</option>
        <option value="18">18</option>
        <option value="21">21</option>
        <option value="24">24</option>
      </select>
      <label class="advantage-check">
        <input type="checkbox" class="advantage-checkbox" />
        <span>Ventaja</span>
      </label>
      <label class="disadvantage-check">
        <input type="checkbox" class="disadvantage-checkbox" />
        <span>Desventaja</span>
      </label>
    </div>


  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="principal" data-action="changeTab">
      <i class="fa-solid fa-user"></i>
      <span>Principal</span>
    </a>
    <a class="item" data-tab="equipo" data-action="changeTab">
      <i class="fa-solid fa-shield"></i>
      <span>Equipo</span>
    </a>
    <a class="item" data-tab="ventajas" data-action="changeTab">
      <i class="fa-solid fa-star"></i>
      <span>Ventajas</span>
    </a>
  </nav>
  </div>
